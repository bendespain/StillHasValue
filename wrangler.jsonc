{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stillhasvalue",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "compatibility_flags": ["nodejs_compat"]
}
