# Copy to .dev.vars for local wrangler — never commit real values.
#
# Voice mint (shared FE mint Worker):
#   wrangler secret put VOICE_MINT_URL        # optional; defaults to https://fe-voice-mint.ben-e22.workers.dev
#   wrangler secret put VOICE_TEST_MINT_KEY  # REQUIRED for Ben free tests; must match mint TEST_MINT_KEY
#   wrangler secret put VOICE_BEN_TEST       # optional; set to true/1 for phone tests without CF Access
#
# Free test mint attaches VOICE_TEST_MINT_KEY only when:
#   - VOICE_BEN_TEST is true/1, OR
#   - Cloudflare Access session is present (Cf-Access-Jwt-Assertion / Access cookies)
# Public callers without payment still get 402. Typed /api/pickup stays free.
# Turn VOICE_BEN_TEST off when not actively testing — it unlocks free mint for anyone who hits Talk.

TURNSTILE_SECRET_KEY=
VOICE_MINT_URL=https://fe-voice-mint.ben-e22.workers.dev
VOICE_TEST_MINT_KEY=
VOICE_BEN_TEST=
